{% extends 'base.twig' %}

{% block content %}
<section class="archive-shell">
  <h1>{{ archive_title ?: 'Archive' }}</h1>
  {% if archive_description %}
    <div class="archive-description">{{ archive_description|raw }}</div>
  {% endif %}

  {% include 'partials/filter-bar.twig' with { active: active_filter } %}

  {% if posts %}
    <ul class="post-card-list">
      {% for post in posts %}
        {% include 'partials/post-card.twig' %}
      {% endfor %}
    </ul>
  {% else %}
    <p class="no-content">No entries found.</p>
  {% endif %}
</section>
{% endblock %}
