<section class="sidebar-section sidebar-playlist-panel">
  <h2 class="section-label">{{ sidebar_playlist.section_title|e }}</h2>

  {% if sidebar_playlist.videos %}
  <ul class="sidebar-video-list">
    {% for video in sidebar_playlist.videos %}
    <li class="sidebar-video-item">
      <button class="sidebar-video-btn"
              type="button"
              data-video-id="{{ video.yt_video_id|e('html_attr') }}"
              aria-expanded="false"
              aria-label="{{ ('Play ' ~ video.title)|e('html_attr') }}">
        <div class="sidebar-video-thumb">
          {% if video.yt_thumbnail_url %}
            <img src="{{ function('esc_url', video.yt_thumbnail_url) }}" alt="{{ video.title|e('html_attr') }}" loading="lazy">
          {% else %}
            <div class="sidebar-video-thumb-placeholder"></div>
          {% endif %}
          {% if video.yt_duration_formatted %}
            <span class="sidebar-video-duration">{{ video.yt_duration_formatted|e }}</span>
          {% endif %}
        </div>
        <p class="sidebar-video-title">{{ video.title|e }}</p>
      </button>
      <div class="sidebar-video-embed" hidden>
        <button class="video-embed-close" type="button" aria-label="Close video">✕</button>
        <iframe
          src="about:blank"
          allow="autoplay; encrypted-media"
          allowfullscreen
          title="{{ video.title|e('html_attr') }}"
        ></iframe>
        {% if sidebar_playlist.permalink %}
        <a class="sidebar-pl-embed-link"
           href="{{ function('esc_url', sidebar_playlist.permalink) }}">View full playlist →</a>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if sidebar_playlist.type == 'playlist' and sidebar_playlist.permalink %}
  <a href="{{ function('esc_url', sidebar_playlist.permalink) }}" class="sidebar-pl-view-all">View full playlist →</a>
  {% endif %}
</section>
