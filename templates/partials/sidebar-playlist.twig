<section class="sidebar-section sidebar-playlist-panel">
  <h2 class="section-label">{{ sidebar_playlist.section_title|e }}</h2>

  {% if sidebar_playlist.videos %}
  <ul class="sidebar-video-list">
    {% for video in sidebar_playlist.videos %}
    <li class="sidebar-video-item">
      <a href="{{ function('esc_url', 'https://www.youtube.com/watch?v=' ~ (video.yt_video_id|url_encode)) }}"
         class="sidebar-video-link"
         target="_blank"
         rel="noopener noreferrer">
        <div class="sidebar-video-thumb">
          {% if video.yt_thumbnail_url %}
            <img src="{{ function('esc_url', video.yt_thumbnail_url) }}" alt="{{ video.title|e('html_attr') }}" loading="lazy">
          {% else %}
            <div class="sidebar-video-thumb-placeholder"></div>
          {% endif %}
          {% if video.yt_duration %}
            <span class="sidebar-video-duration">{{ video.yt_duration|e }}</span>
          {% endif %}
        </div>
        <p class="sidebar-video-title">{{ video.title|e }}</p>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if sidebar_playlist.type == 'playlist' and sidebar_playlist.permalink %}
  <a href="{{ function('esc_url', sidebar_playlist.permalink) }}" class="sidebar-pl-view-all">View full playlist →</a>
  {% endif %}
</section>
