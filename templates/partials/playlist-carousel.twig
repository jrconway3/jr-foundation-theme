<div class="playlist-carousel" data-playlist-id="{{ playlist.ID|e('html_attr') }}">
  <div class="playlist-carousel-header">
    <a href="{{ function('esc_url', playlist.permalink) }}" class="playlist-carousel-name">{{ playlist.title|e }}</a>
    {% if playlist.yt_video_count %}
      <span class="playlist-video-count">{{ playlist.yt_video_count }} videos</span>
    {% endif %}
  </div>

  {% if playlist.videos %}
  <div class="video-strip">
    {% for video in playlist.videos %}
    <div class="video-card"
         data-video-id="{{ video.yt_video_id|e('html_attr') }}"
         tabindex="0"
         role="button"
         aria-expanded="false"
         aria-label="{{ ('Play ' ~ video.title)|e('html_attr') }}">
      <div class="video-card__thumb">
        {% if video.yt_thumbnail_url %}
          <img src="{{ function('esc_url', video.yt_thumbnail_url) }}" alt="{{ video.title|e('html_attr') }}" loading="lazy">
        {% else %}
          <div class="video-card__thumb-placeholder"></div>
        {% endif %}
        {% if video.yt_duration %}
          <span class="video-card__duration">{{ video.yt_duration|e }}</span>
        {% endif %}
      </div>
      <div class="video-card__embed" hidden>
        <iframe
          src="about:blank"
          allow="autoplay; encrypted-media"
          allowfullscreen
          title="{{ video.title|e('html_attr') }}"
        ></iframe>
        <a class="watch-on-yt"
           href="{{ function('esc_url', 'https://www.youtube.com/watch?v=' ~ (video.yt_video_id|url_encode)) }}"
           target="_blank"
           rel="noopener noreferrer">Watch on YouTube ↗</a>
      </div>
      <p class="video-card__title">{{ video.title|e }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
