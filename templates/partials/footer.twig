<footer class="site-footer">
  <div class="inner">
    {% if menu_footer %}
      <nav class="footer-nav" aria-label="Footer">
        <ul>
          {% for item in menu_footer.items %}
            <li><a href="{{ item.link }}">{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
    <p>&copy; {{ 'now'|date('Y') }} {{ function('get_bloginfo', 'name') }}</p>
  </div>
</footer>
