{% extends 'base.twig' %}

{% block content %}

{% if post.thumbnail or post.title %}
<div class="page-profile-header">
  {% if post.thumbnail %}
  <div class="page-profile-thumb">
    <img src="{{ function('esc_url', post.thumbnail.src('thumbnail')) }}" alt="{{ post.thumbnail.alt|e('html_attr') }}">
  </div>
  {% endif %}
  <div class="page-profile-info">
    <h1 class="page-title">{{ post.title|e }}</h1>
    {% if post.excerpt %}
    <p class="page-subtitle">{{ post.excerpt|striptags|e }}</p>
    {% endif %}
  </div>
</div>
{% endif %}

<div class="site-shell">

  <article class="single-post single-page">
    <div class="post-content page-content">{{ post.content }}</div>
  </article>

  <aside class="single-sidebar">

    {% include 'partials/sidebar-games.twig' %}

  </aside>

</div>
{% endblock %}
